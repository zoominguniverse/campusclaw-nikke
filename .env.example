# Copy to .env and replace every value before starting the stack.
SECRET_KEY=replace-with-a-long-random-server-secret
POSTGRES_DB=campusclaw
POSTGRES_USER=campusclaw
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://campusclaw:replace-with-a-strong-database-password@postgres:5432/campusclaw
SEED_DEMO_DATA=true
PURGE_LEGACY_DEMO_DATA=false
# A JSON object containing every private local-demo password.  Use one non-empty
# memorable random phrase per pinyin username; do not commit actual passwords.
DEMO_ACCOUNT_PASSWORDS={"zhangruoxi":"replace-with-a-local-password","liuyifei":"replace-with-a-local-password","chenwanqing":"replace-with-a-local-password","zhouziyan":"replace-with-a-local-password","linzimo":"replace-with-a-local-password","wangyuxin":"replace-with-a-local-password","chenzixuan":"replace-with-a-local-password","zhoumingyuan":"replace-with-a-local-password","liqinghe":"replace-with-a-local-password","sunwanru":"replace-with-a-local-password","hejiayi":"replace-with-a-local-password","songxinyue":"replace-with-a-local-password","panhaoran":"replace-with-a-local-password","wumengyao":"replace-with-a-local-password","gaoxiaoyu":"replace-with-a-local-password","taoyichen":"replace-with-a-local-password","xiaowenhao":"replace-with-a-local-password","luojingyan":"replace-with-a-local-password","shenqianyu":"replace-with-a-local-password","guoxinyi":"replace-with-a-local-password","yeyuhan":"replace-with-a-local-password","zhouchengxi":"replace-with-a-local-password","xiewanqing":"replace-with-a-local-password","chendongyi":"replace-with-a-local-password"}
MAX_UPLOAD_BYTES=5242880
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=60
# `deterministic` is suitable for local demos/tests. Set provider to
# `openai-compatible` and configure the API URL/key/model for a real model.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=campusclaw-deterministic
EMBEDDING_DIMENSIONS=64
CHAT_PROVIDER=deterministic
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=campusclaw-deterministic
# Optional host port for the browser-facing web service (default: 5173).
WEB_PORT=5173
