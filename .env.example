# Copy to .env and replace every value before starting the stack.
SECRET_KEY=replace-with-a-long-random-server-secret
POSTGRES_DB=campusclaw
POSTGRES_USER=campusclaw
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://campusclaw:replace-with-a-strong-database-password@postgres:5432/campusclaw
SEED_DEMO_DATA=true
DEMO_TEACHER_PASSWORD=replace-teacher-demo-password
DEMO_TEACHER_B_PASSWORD=replace-teacher-b-demo-password
DEMO_STUDENT_A_PASSWORD=replace-student-a-demo-password
DEMO_STUDENT_A2_PASSWORD=replace-student-a2-demo-password
DEMO_STUDENT_B_PASSWORD=replace-student-b-demo-password
DEMO_STUDENT_B2_PASSWORD=replace-student-b2-demo-password
MAX_UPLOAD_BYTES=5242880
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=60
